{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Nome da vendedora" },
        "email": { "type": "string", "description": "E-mail de login" },
        "photoURL": { "type": "string", "description": "URL da foto do Google perfil" },
        "loja": { "type": "string", "description": "Unidade / Filial Serallê" },
        "createdAt": { "type": "string", "description": "Data de cadastro ISO" },
        "lastLoginAt": { "type": "string", "description": "Último login ISO" }
      }
    },
    "Venda": {
      "collection": "users/{userId}/vendas",
      "fields": {
        "id": { "type": "string", "description": "ID da venda / data YYYY-MM-DD" },
        "data": { "type": "string", "description": "Data da venda" },
        "mesId": { "type": "string", "description": "Mês de referência YYYY-MM" },
        "isFolga": { "type": "boolean", "description": "Dia de folga" },
        "obs": { "type": "string", "description": "Observações do dia" },
        "lancamentos": { "type": "array", "description": "Itens vendidos por categoria" },
        "updatedAt": { "type": "string", "description": "Timestamp de atualização" }
      }
    },
    "ConfigMes": {
      "collection": "users/{userId}/configMes",
      "fields": {
        "mesId": { "type": "string", "description": "ID do mês YYYY-MM" },
        "metaDiariaValor": { "type": "number", "description": "Meta diária R$" },
        "metaDiariaPares": { "type": "number", "description": "Meta diária pares" },
        "cotaA": { "type": "object", "description": "Meta Cota A" },
        "cotaB": { "type": "object", "description": "Meta Cota B" },
        "cotaC": { "type": "object", "description": "Meta Cota C" },
        "cotaAlta": { "type": "object", "description": "Meta Cota Alta" }
      }
    }
  }
}

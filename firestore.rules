rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acesso exclusivo do usuário aos seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Permitir acesso exclusivo a todas as subcoleções (vendas, configMes, etc.)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Permitir sincronização e recuperação por Código de Sincronização (persistente na nuvem)
    match /sync_stores/{syncCode} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }
  }
}

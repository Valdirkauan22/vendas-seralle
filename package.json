    "@capacitor/push-notifications": "^8.1.2",
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.0.9",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "qrcode.react": "^4.2.0",
